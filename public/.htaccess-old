<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # HostGator: domínio principal sempre redireciona para a unidade Barra.
    # A condição por hostname evita loop quando a requisição já está em barra.locxmotos.com.br.
    RewriteCond %{HTTP_HOST} ^(?:www\.)?locxmotos\.com\.br$ [NC]
    RewriteRule ^(.*)$ https://barra.locxmotos.com.br/$1 [R=301,L]

    # The domain document root already points to this public directory.
    # Redirect old addresses that incorrectly repeat /public.
    RewriteRule ^public(?:/index\.php)?/?$ / [R=301,L]

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
